{
  "name": "inkstone-reader",
  "version": "0.1.4",
  "description": "墨读 · 本地 Markdown 阅读与批注",
  "main": "out/main/index.js",
  "author": "Inkstone",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac zip",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src electron tests *.ts *.json index.html"
  },
  "build": {
    "appId": "app.inkstone.reader",
    "productName": "Inkstone",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "normal"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "chokidar": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "lucide-react": "^1.66.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
